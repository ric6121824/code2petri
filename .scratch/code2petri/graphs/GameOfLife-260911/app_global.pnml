      <transition id="t1">
        <name>
          <text>const canvasCpu = call: document.getElementById()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t2">
        <name>
          <text>const canvasGpu = call: document.getElementById()</text>

      <transition id="t9">
        <name>
          <text>const CELL_SIZE = 4</text>
        </name>
      </transition>
      <transition id="t10">
        <name>
          <text>const ROWS = 150</text>
        </name>
      </transition>
      <transition id="t11">
        <name>
          <text>const COLS = 200</text>
        </name>
      </transition>
      <transition id="t12">
        <name>
          <text>canvasCpu.width = COLS * CELL_SIZE</text>
        </name>
      </transition>
      <transition id="t13">
        <name>
          <text>canvasCpu.height = ROWS * CELL_SIZE</text>
        </name>
      </transition>
      <transition id="t14">

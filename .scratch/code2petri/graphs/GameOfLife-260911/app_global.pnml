          <text>canvasGpu.width = COLS * CELL_SIZE</text>
        </name>
      </transition>
      <transition id="t15">
        <name>
          <text>canvasGpu.height = ROWS * CELL_SIZE</text>
        </name>
      </transition>
      <transition id="t16">

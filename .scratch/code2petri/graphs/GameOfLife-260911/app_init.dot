digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor="#2e7d32", fontcolor=white, label="call: randomizeBoth() (line 40)", color="#2e7d32", tooltip="Resolved to randomizeBoth in /Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js"];
    "t2" [shape=rect, style=filled, fillcolor="#2e7d32", fontcolor=white, label="call: setupEventListeners() (line 41)", color="#2e7d32", tooltip="Resolved to setupEventListeners in /Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p_end";
}

      <transition id="t1">
        <name>
          <text>const gl = this.gl</text>
        </name>
      </transition>
      <transition id="t2">
        <name>
          <text>call: gl.useProgram()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t3">
        <name>
          <text>call: gl.bindFramebuffer()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t4">
        <name>
          <text>call: gl.viewport()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t5">
        <name>
          <text>call: gl.enableVertexAttribArray()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t6">
        <name>
          <text>call: gl.vertexAttribPointer()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t7">
        <name>
          <text>call: gl.activeTexture()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t8">
        <name>
          <text>call: gl.bindTexture()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t9">
        <name>
          <text>const stateLoc = call: gl.getUniformLocation()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t10">
        <name>
          <text>call: gl.uniform1i()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t11">
        <name>
          <text>call: gl.drawArrays()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <arc id="a1" source="p0" target="t1" />

digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];
    "p2" [shape=circle, label="p2"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor="#2e7d32", fontcolor=white, label="grid = call: createGrid() (line 57)", color="#2e7d32", tooltip="Resolved to createGrid in /Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js"];
    "t2" [shape=rect, style=filled, fillcolor="#2e7d32", fontcolor=white, label="call: drawCpuGrid() (line 58)", color="#2e7d32", tooltip="Resolved to drawCpuGrid in /Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js"];
    "t3" [shape=rect, style=filled, fillcolor="#2e7d32", fontcolor=white, label="call: gpuEngine.randomize() (line 61)", color="#2e7d32", tooltip="Resolved to WebGLEngine.randomize in /Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/webgl-engine.js"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p2";
    "p2" -> "t3";
    "t3" -> "p_end";
}

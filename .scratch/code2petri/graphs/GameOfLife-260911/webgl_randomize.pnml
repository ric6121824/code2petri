<?xml version='1.0' encoding='utf-8'?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net0" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>PetriNet</text>
    </name>
    <page id="page0">
      <place id="p0">
        <name>
          <text>start</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="p_end">
        <name>
          <text>end</text>
        </name>
      </place>
      <place id="p1">
        <name>
          <text>p1</text>
        </name>
      </place>
      <place id="p2">
        <name>
          <text>p2</text>
        </name>
      </place>
      <place id="p3">
        <name>
          <text>exit_t3</text>
        </name>
      </place>
      <place id="p4">
        <name>
          <text>p4</text>
        </name>
      </place>
      <place id="p5">
        <name>
          <text>p5</text>
        </name>
      </place>
      <place id="p6">
        <name>
          <text>p6</text>
        </name>
      </place>
      <transition id="t1">
        <name>
          <text>const gl = this.gl</text>
        </name>
      </transition>
      <transition id="t2">
        <name>
          <text>const data = new Uint8Array(this.width * this.height)</text>
        </name>
      </transition>
      <transition id="t3">
        <name>
          <text>for(let i=0; i&lt;data.length; i++)</text>
        </name>
      </transition>
      <transition id="t4">
        <name>
          <text>exit</text>
        </name>
      </transition>
      <transition id="t5">
        <name>
          <text>data[i] = Math.random() &gt; 0.8 ? 255 : 0</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t6">
        <name>
          <text>call: gl.bindTexture()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t7">
        <name>
          <text>call: gl.texSubImage2D()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <transition id="t8">
        <name>
          <text>call: this.drawToScreen()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <resolved target="WebGLEngine.drawToScreen" file="/Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/webgl-engine.js" />
        </toolspecific>
      </transition>
      <arc id="a1" source="p0" target="t1" />
      <arc id="a2" source="t1" target="p1" />
      <arc id="a3" source="p1" target="t2" />
      <arc id="a4" source="t2" target="p2" />
      <arc id="a5" source="p2" target="t3" />
      <arc id="a6" source="p2" target="t4" />
      <arc id="a7" source="t3" target="p4" />
      <arc id="a8" source="p4" target="t5" />
      <arc id="a9" source="t5" target="p2" />
      <arc id="a10" source="t4" target="p3" />
      <arc id="a11" source="p3" target="t6" />
      <arc id="a12" source="t6" target="p5" />
      <arc id="a13" source="p5" target="t7" />
      <arc id="a14" source="t7" target="p6" />
      <arc id="a15" source="p6" target="t8" />
      <arc id="a16" source="t8" target="p_end" />
    </page>
  </net>
</pnml>
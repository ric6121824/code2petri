<?xml version='1.0' encoding='utf-8'?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net0" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>PetriNet</text>
    </name>
    <page id="page0">
      <place id="p0">
        <name>
          <text>start</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="p_end">
        <name>
          <text>end</text>
        </name>
      </place>
      <place id="p1">
        <name>
          <text>p1</text>
        </name>
      </place>
      <place id="p2">
        <name>
          <text>exit_t2</text>
        </name>
      </place>
      <place id="p3">
        <name>
          <text>p3</text>
        </name>
      </place>
      <place id="p4">
        <name>
          <text>p4</text>
        </name>
      </place>
      <place id="p5">
        <name>
          <text>p5</text>
        </name>
      </place>
      <place id="p6">
        <name>
          <text>p6</text>
        </name>
      </place>
      <place id="p7">
        <name>
          <text>p7</text>
        </name>
      </place>
      <place id="p8">
        <name>
          <text>p8</text>
        </name>
      </place>
      <place id="p9">
        <name>
          <text>p9</text>
        </name>
      </place>
      <place id="p10">
        <name>
          <text>p10</text>
        </name>
      </place>
      <place id="p11">
        <name>
          <text>p11</text>
        </name>
      </place>
      <transition id="t1">
        <name>
          <text>let nextGrid = call: createGrid()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <resolved target="createGrid" file="/Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js" />
        </toolspecific>
      </transition>
      <transition id="t2">
        <name>
          <text>for (let i = 0; i &lt; ROWS; i++)</text>
        </name>
      </transition>
      <transition id="t3">
        <name>
          <text>exit</text>
        </name>
      </transition>
      <transition id="t4">
        <name>
          <text>for (let j = 0; j &lt; COLS; j++)</text>
        </name>
      </transition>
      <transition id="t5">
        <name>
          <text>exit</text>
        </name>
      </transition>
      <transition id="t6">
        <name>
          <text>let state = grid[i][j]</text>
        </name>
      </transition>
      <transition id="t7">
        <name>
          <text>let neighbors = call: countNeighbors()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <resolved target="countNeighbors" file="/Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js" />
        </toolspecific>
      </transition>
      <transition id="t8">
        <name>
          <text>if (state === 0 &amp;&amp; neighbors === 3)</text>
        </name>
      </transition>
      <transition id="t9">
        <name>
          <text>else</text>
        </name>
      </transition>
      <transition id="t10">
        <name>
          <text>nextGrid[i][j] = 1</text>
        </name>
      </transition>
      <transition id="t11">
        <name>
          <text>if (state === 1 &amp;&amp; (neighbors &lt; 2 || neighbors &gt; 3))</text>
        </name>
      </transition>
      <transition id="t12">
        <name>
          <text>else</text>
        </name>
      </transition>
      <transition id="t13">
        <name>
          <text>nextGrid[i][j] = 0</text>
        </name>
      </transition>
      <transition id="t14">
        <name>
          <text>nextGrid[i][j] = state</text>
        </name>
      </transition>
      <transition id="t15">
        <name>
          <text>grid = nextGrid</text>
        </name>
      </transition>
      <transition id="t16">
        <name>
          <text>call: drawCpuGrid()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <resolved target="drawCpuGrid" file="/Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js" />
        </toolspecific>
      </transition>
      <arc id="a1" source="p0" target="t1" />
      <arc id="a2" source="t1" target="p1" />
      <arc id="a3" source="p1" target="t2" />
      <arc id="a4" source="p1" target="t3" />
      <arc id="a5" source="t2" target="p3" />
      <arc id="a6" source="p3" target="t4" />
      <arc id="a7" source="p3" target="t5" />
      <arc id="a8" source="t4" target="p4" />
      <arc id="a9" source="p4" target="t6" />
      <arc id="a10" source="t6" target="p5" />
      <arc id="a11" source="p5" target="t7" />
      <arc id="a12" source="t7" target="p6" />
      <arc id="a13" source="p6" target="t8" />
      <arc id="a14" source="p6" target="t9" />
      <arc id="a15" source="t8" target="p7" />
      <arc id="a16" source="p7" target="t10" />
      <arc id="a17" source="t10" target="p3" />
      <arc id="a18" source="t9" target="p8" />
      <arc id="a19" source="p8" target="t11" />
      <arc id="a20" source="p8" target="t12" />
      <arc id="a21" source="t11" target="p9" />
      <arc id="a22" source="p9" target="t13" />
      <arc id="a23" source="t13" target="p3" />
      <arc id="a24" source="t12" target="p10" />
      <arc id="a25" source="p10" target="t14" />
      <arc id="a26" source="t14" target="p3" />
      <arc id="a27" source="t5" target="p1" />
      <arc id="a28" source="t3" target="p2" />
      <arc id="a29" source="p2" target="t15" />
      <arc id="a30" source="t15" target="p11" />
      <arc id="a31" source="p11" target="t16" />
      <arc id="a32" source="t16" target="p_end" />
    </page>
  </net>
</pnml>
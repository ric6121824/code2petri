digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];
    "p2" [shape=circle, label="p2"];
    "p3" [shape=circle, label="exit_t3"];
    "p4" [shape=circle, label="p4"];
    "p5" [shape=circle, label="p5"];
    "p6" [shape=circle, label="p6"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const gl = this.gl (line 153)"];
    "t2" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const data = new Uint8Array(this.width * this.height) (line 154)"];
    "t3" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="for(let i=0; i<data.length; i++) (line 155)"];
    "t4" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="exit (line 155)"];
    "t5" [shape=rect, style=filled, fillcolor="#e65100", fontcolor=white, label="data[i] = Math.random() > 0.8 ? 255 : 0 (line 156)", color="#e65100", tooltip="Unresolved call"];
    "t6" [shape=rect, style=filled, fillcolor="#e65100", fontcolor=white, label="call: gl.bindTexture() (line 159)", color="#e65100", tooltip="Unresolved call"];
    "t7" [shape=rect, style=filled, fillcolor="#e65100", fontcolor=white, label="call: gl.texSubImage2D() (line 160)", color="#e65100", tooltip="Unresolved call"];
    "t8" [shape=rect, style=filled, fillcolor="#2e7d32", fontcolor=white, label="call: this.drawToScreen() (line 161)", color="#2e7d32", tooltip="Resolved to WebGLEngine.drawToScreen in /Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/webgl-engine.js"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p2";
    "p2" -> "t3";
    "p2" -> "t4";
    "t3" -> "p4";
    "p4" -> "t5";
    "t5" -> "p2";
    "t4" -> "p3";
    "p3" -> "t6";
    "t6" -> "p5";
    "p5" -> "t7";
    "t7" -> "p6";
    "p6" -> "t8";
    "t8" -> "p_end";
}

<?xml version='1.0' encoding='utf-8'?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net0" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>PetriNet</text>
    </name>
    <page id="page0">
      <place id="p0">
        <name>
          <text>start</text>
        </name>
        <initialMarking>
          <text>1</text>
        </initialMarking>
      </place>
      <place id="p_end">
        <name>
          <text>end</text>
        </name>
      </place>
      <place id="p1">
        <name>
          <text>merge_t1</text>
        </name>
      </place>
      <place id="p2">
        <name>
          <text>p2</text>
        </name>
      </place>
      <place id="p3">
        <name>
          <text>merge_t4</text>
        </name>
      </place>
      <place id="p4">
        <name>
          <text>p4</text>
        </name>
      </place>
      <place id="p5">
        <name>
          <text>merge_t6</text>
        </name>
      </place>
      <place id="p6">
        <name>
          <text>p6</text>
        </name>
      </place>
      <place id="p7">
        <name>
          <text>p7</text>
        </name>
      </place>
      <transition id="t1">
        <name>
          <text>if (!isRunning)</text>
        </name>
      </transition>
      <transition id="t2">
        <name>
          <text>else</text>
        </name>
      </transition>
      <transition id="t3">
        <name>
          <text>return</text>
        </name>
      </transition>
      <transition id="t4">
        <name>
          <text>if (timestamp - lastFrameTime &gt; speed)</text>
        </name>
      </transition>
      <transition id="t5">
        <name>
          <text>else</text>
        </name>
      </transition>
      <transition id="t6">
        <name>
          <text>if (mode === 'gpu')</text>
        </name>
      </transition>
      <transition id="t7">
        <name>
          <text>else</text>
        </name>
      </transition>
      <transition id="t8">
        <name>
          <text>call: gpuEngine.step()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <resolved target="WebGLEngine.step" file="/Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/webgl-engine.js" />
        </toolspecific>
      </transition>
      <transition id="t9">
        <name>
          <text>call: stepCpu()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <resolved target="stepCpu" file="/Users/pingchungtsai/My Drive (ric6121824@gmail.com)/Digital Media MSc/Semester 4/GameOfLife_Simulator/app.js" />
        </toolspecific>
      </transition>
      <transition id="t10">
        <name>
          <text>lastFrameTime = timestamp</text>
        </name>
      </transition>
      <transition id="t11">
        <name>
          <text>animationId = call: requestAnimationFrame()</text>
        </name>
        <toolspecific tool="code2petri" version="1.0">
          <unresolved />
        </toolspecific>
      </transition>
      <arc id="a1" source="p0" target="t1" />
      <arc id="a2" source="p0" target="t2" />
      <arc id="a3" source="t1" target="p2" />
      <arc id="a4" source="p2" target="t3" />
      <arc id="a5" source="t3" target="p_end" />
      <arc id="a6" source="t2" target="p1" />
      <arc id="a7" source="p1" target="t4" />
      <arc id="a8" source="p1" target="t5" />
      <arc id="a9" source="t4" target="p4" />
      <arc id="a10" source="p4" target="t6" />
      <arc id="a11" source="p4" target="t7" />
      <arc id="a12" source="t6" target="p6" />
      <arc id="a13" source="p6" target="t8" />
      <arc id="a14" source="t8" target="p5" />
      <arc id="a15" source="t7" target="p7" />
      <arc id="a16" source="p7" target="t9" />
      <arc id="a17" source="t9" target="p5" />
      <arc id="a18" source="p5" target="t10" />
      <arc id="a19" source="t10" target="p3" />
      <arc id="a20" source="t5" target="p3" />
      <arc id="a21" source="p3" target="t11" />
      <arc id="a22" source="t11" target="p0" />
      <arc id="a23" source="t11" target="p_end" />
    </page>
  </net>
</pnml>
    "t10" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let dist = call: diff.mag() (line 329)"];
    "t11" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="if (dist > maxDistance) (line 330)"];
    "t12" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="else (line 330)"];
    "t13" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="return (line 330)"];

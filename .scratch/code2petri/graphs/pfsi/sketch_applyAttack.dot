    "t16" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let saDiff = call: abs() (line 335)"];
    "t17" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let saFactor = call: map() (line 339)"];
    "t18" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="if  (saDiff > 5 || RedBall.wearFactor < 10) (line 342)"];
    "t19" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="else (line 349)"];
    "t20" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let attackStrength = 20 (line 343)"];
    "t21" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let strength = (attackStrength / (dist)) * saFactor (line 344)"];
    "t22" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let force = call: diff.setMag() (line 346)"];
    "t23" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: ball.vel.add() (line 347)"];
    "t24" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="return (line 349)"];


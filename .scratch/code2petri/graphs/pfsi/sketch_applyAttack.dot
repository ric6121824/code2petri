    "t3" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="return (line 318)"];
    "t4" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const cooldownDuration = 2000 (line 320)"];
    "t5" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="if (millis() - ball.lastHitTime < cooldownDuration) (line 321)"];
    "t6" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="else (line 321)"];
    "t7" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="return (line 322)"];

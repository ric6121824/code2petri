digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];
    "p2" [shape=circle, label="p2"];
    "p3" [shape=circle, label="p3"];
    "p4" [shape=circle, label="p4"];
    "p5" [shape=circle, label="p5"];
    "p6" [shape=circle, label="p6"];
    "p7" [shape=circle, label="p7"];
    "p8" [shape=circle, label="p8"];
    "p9" [shape=circle, label="p9"];
    "p10" [shape=circle, label="p10"];
    "p11" [shape=circle, label="p11"];
    "p12" [shape=circle, label="p12"];
    "p13" [shape=circle, label="p13"];
    "p14" [shape=circle, label="p14"];
    "p15" [shape=circle, label="p15"];
    "p16" [shape=circle, label="p16"];
    "p17" [shape=circle, label="p17"];
    "p18" [shape=circle, label="p18"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let started = false (line 4)"];
    "t2" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let dataReceived = false (line 5)"];
    "t3" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let socket (line 6)"];
    "t4" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let alpha = 0, beta = 0, gamma = 0 (line 7)"];
    "t5" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let shieldOn = false (line 8)"];
    "t6" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const redBall = { (line 11)"];
    "t7" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const balls = { (line 29)"];
    "t8" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const scratches = { (line 42)"];
    "t9" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const maxBalls = 100 (line 50)"];
    "t10" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const firstSpawnDelay = 300 (line 51)"];
    "t11" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const regularSpawnInterval = 60 (line 52)"];
    "t12" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let frameCounter = 0 (line 53)"];
    "t13" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let firstSpawnDone = false (line 54)"];
    "t14" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let bgMusic (line 57)"];
    "t15" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let slashSound (line 58)"];
    "t16" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let hitSound (line 59)"];
    "t17" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let vol = 1.0 (line 60)"];
    "t18" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let lastHitSoundTime = 0 (line 61)"];
    "t19" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const hitCooldown = 50 (line 62)"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p2";
    "p2" -> "t3";
    "t3" -> "p3";
    "p3" -> "t4";
    "t4" -> "p4";
    "p4" -> "t5";
    "t5" -> "p5";
    "p5" -> "t6";
    "t6" -> "p6";
    "p6" -> "t7";
    "t7" -> "p7";
    "p7" -> "t8";
    "t8" -> "p8";
    "p8" -> "t9";
    "t9" -> "p9";
    "p9" -> "t10";
    "t10" -> "p10";
    "p10" -> "t11";
    "t11" -> "p11";
    "p11" -> "t12";
    "t12" -> "p12";
    "p12" -> "t13";
    "t13" -> "p13";
    "p13" -> "t14";
    "t14" -> "p14";
    "p14" -> "t15";
    "t15" -> "p15";
    "p15" -> "t16";
    "t16" -> "p16";
    "p16" -> "t17";
    "t17" -> "p17";
    "p17" -> "t18";
    "t18" -> "p18";
    "p18" -> "t19";
    "t19" -> "p_end";
}

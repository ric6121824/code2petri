digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];
    "p2" [shape=circle, label="p2"];
    "p3" [shape=circle, label="p3"];
    "p4" [shape=circle, label="p4"];
    "p5" [shape=circle, label="p5"];
    "p6" [shape=circle, label="p6"];
    "p7" [shape=circle, label="p7"];
    "p8" [shape=circle, label="p8"];
    "p9" [shape=circle, label="p9"];
    "p10" [shape=circle, label="p10"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const http = call: require() (line 2)"];
    "t2" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const fs = call: require() (line 3)"];
    "t3" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const path = call: require() (line 4)"];
    "t4" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const WebSocket = call: require() (line 5)"];
    "t5" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const publicDir = call: path.join() (line 7)"];
    "t6" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const server = call: http.createServer() (line 8)"];
    "t7" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const wss = new WebSocket.Server({ server }) (line 35)"];
    "t8" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let clients = [] (line 36)"];
    "t9" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: wss.on() (line 38)"];
    "t10" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="nst PORT = 3000 (line 63)"];
    "t11" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: rver.l.listen() (line 64)"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p2";
    "p2" -> "t3";
    "t3" -> "p3";
    "p3" -> "t4";
    "t4" -> "p4";
    "p4" -> "t5";
    "t5" -> "p5";
    "p5" -> "t6";
    "t6" -> "p6";
    "p6" -> "t7";
    "t7" -> "p7";
    "p7" -> "t8";
    "t8" -> "p8";
    "p8" -> "t9";
    "t9" -> "p9";
    "p9" -> "t10";
    "t10" -> "p10";
    "p10" -> "t11";
    "t11" -> "p_end";
}

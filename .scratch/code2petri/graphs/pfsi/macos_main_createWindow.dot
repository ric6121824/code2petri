digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const mainWindow = new BrowserWindow({ (line 9)"];
    "t2" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: mainWindow.loadFile() (line 21)"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p_end";
}

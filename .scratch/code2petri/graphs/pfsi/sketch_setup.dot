    "p10" [shape=circle, label="p10"];
    "p11" [shape=circle, label="p11"];
    "p12" [shape=circle, label="p12"];
    "p13" [shape=circle, label="p13"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: colorMode() (line 55)"];
    "t2" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: createCanvas() (line 56)"];
    "t3" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://' (line 59)"];
    "t4" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="const socket = new WebSocket('wss://lively-splendid-tetra.ngrok-free.app') (line 60)"];
    "t5" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="socket.onopen = () => {\n    console.log(\"WebSocket connected to server\");\n  } (line 62)"];
    "t6" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="socket.onmessage = (event) => {\n    console.log(\"Received from socket:\", event.data);\n    \n    let data = event.data;\n\n    if (typeof data === \"string\") {\n      try {\n        data = JSON.parse(data);\n      } catch (e) {\n        console.error(\"JSON parse error:\", e);\n        return;\n      }\n    }\n\n    if (data.alpha !== undefined && data.beta !== undefined && data.gamma !== undefined) {\n      alpha = data.alpha;\n      beta = data.beta;\n      gamma = data.gamma;\n      dataReceived = true;\n    }\n  } (line 66)"];
    "t7" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="socket.onerror = (err) => {\n    console.error(\"WebSocket error:\", err);\n  } (line 88)"];
    "t8" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="socket.onclose = () => {\n    console.log(\"WebSocket connection closed\");\n  } (line 92)"];
    "t9" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="for (let i = 0; i < initialBallCount; i++) (line 96)"];
    "t10" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="exit (line 96)"];
    "t11" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: spawnBallAtBorder() (line 97)"];
    "t12" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="redBall = new RedBall(width / 2, height * 3 / 5) (line 99)"];
    "t13" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="lowpass = new p5.LowPass() (line 101)"];
    "t14" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: lowpass.connect() (line 105)"];
    "t15" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: userStartAudio().then() (line 108)"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p2";
    "p2" -> "t3";
    "t3" -> "p3";
    "p3" -> "t4";
    "t4" -> "p4";
    "p4" -> "t5";
    "t5" -> "p5";
    "p5" -> "t6";
    "t6" -> "p6";
    "p6" -> "t7";
    "t7" -> "p7";
    "p7" -> "t8";
    "t8" -> "p8";
    "p8" -> "t9";
    "p8" -> "t10";
    "t9" -> "p10";
    "p10" -> "t11";
    "t11" -> "p8";
    "t10" -> "p9";
    "p9" -> "t12";
    "t12" -> "p11";
    "p11" -> "t13";
    "t13" -> "p12";
    "p12" -> "t14";

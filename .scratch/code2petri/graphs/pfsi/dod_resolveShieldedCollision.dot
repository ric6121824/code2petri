digraph PetriNet {
    rankdir=TB;

    // Places
    "p0" [shape=circle, label="start (tokens: 1)"];
    "p_end" [shape=circle, label="end"];
    "p1" [shape=circle, label="p1"];
    "p2" [shape=circle, label="p2"];
    "p3" [shape=circle, label="p3"];
    "p4" [shape=circle, label="p4"];
    "p5" [shape=circle, label="p5"];

    // Transitions
    "t1" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let repelDirection = call: p5.Vector.sub() (line 476)"];
    "t2" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let dist = call: repelDirection.mag() (line 477)"];
    "t3" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let clampedDist = call: max() (line 478)"];
    "t4" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let repelMagnitude = 500 / clampedDist (line 479)"];
    "t5" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="let repelForce = call: repelDirection.normalize().mult() (line 480)"];
    "t6" [shape=rect, style=filled, fillcolor=black, fontcolor=white, label="call: squareB.vel.add() (line 481)"];

    // Arcs
    "p0" -> "t1";
    "t1" -> "p1";
    "p1" -> "t2";
    "t2" -> "p2";
    "p2" -> "t3";
    "t3" -> "p3";
    "p3" -> "t4";
    "t4" -> "p4";
    "p4" -> "t5";
    "t5" -> "p5";
    "p5" -> "t6";
    "t6" -> "p_end";
}
